# Firebase web config of the TARGET environment (dev / staging / production). Public identifiers, not secrets.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_APP_ID=
VITE_FIRESTORE_DATABASE_ID=(default)
VITE_FUNCTIONS_REGION=europe-west1
# Optional: Firebase App Check (reCAPTCHA Enterprise site key)
VITE_APPCHECK_SITE_KEY=
# Local development only: talk to the Firebase emulators instead of a real project
VITE_USE_EMULATORS=false
